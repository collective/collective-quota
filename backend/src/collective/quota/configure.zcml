<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="collective.quota"
    >

  <i18n:registerTranslations directory="locales" />

  <include
      package="Products.CMFCore"
      file="permissions.zcml"
      />


  <five:registerPackage
      package="."
      initialize=".initialize"
      />

  <include file="dependencies.zcml" />
  <include file="profiles.zcml" />
  <include file="permissions.zcml" />

  <include package=".browser" />
  <include package=".catalog" />
  <include package=".controlpanels" />
  <include package=".indexers" />
  <include package=".restapi" />
  <include package=".serializers" />
  <include package=".vocabularies" />

  <!-- Hook A: named, so plone.namedfile's own content-type validators stay. -->
  <adapter
      factory=".validators.QuotaUploadValidator"
      provides="plone.namedfile.interfaces.IPluggableFileFieldValidation"
      name="collective.quota"
      />
  <adapter
      factory=".validators.QuotaUploadValidator"
      provides="plone.namedfile.interfaces.IPluggableImageFieldValidation"
      name="collective.quota"
      />

  <!-- Hook D: count new items (no layer: scripts have no request layer). -->
  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".guard.on_item_added"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>

<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.quota"
    >

  <browser:page
      name="quota-rebuild"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".rebuild.QuotaRebuildView"
      permission="collective.quota.ManageSettings"
      layer="collective.quota.interfaces.IBrowserLayer"
      />

  <browser:page
      name="quota-usage"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".usage.DiskUsageView"
      permission="collective.quota.ViewDiskUsage"
      layer="collective.quota.interfaces.IBrowserLayer"
      />

  <browser:page
      name="quota-delete"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".delete.QuotaDeleteView"
      permission="collective.quota.ViewDiskUsage"
      layer="collective.quota.interfaces.IBrowserLayer"
      />

  <!-- Hook B: block_all refuses new items in Dexterity add forms. -->
  <adapter factory=".addform_guard.QuotaAddFormValidator" />

  <!-- Hook D: show the guard message to everybody, not only to managers. -->
  <browser:page
      name="index.html"
      for="..guard.QuotaCommitAborted"
      class=".errors.QuotaCommitAbortedView"
      permission="zope2.Public"
      layer="..interfaces.IBrowserLayer"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>

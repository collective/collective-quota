<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="collective.quota"
>
  <body>
    <metal:main fill-slot="main">
      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Disk quota exceeded</h1>
      <div class="alert alert-danger"
           id="quota-error-message"
           role="alert"
           tal:content="options/message"
      >The change was cancelled.</div>
      <p i18n:translate="">
        Nothing was saved. Delete or shrink existing files, or ask a site
        administrator to raise the quota.
      </p>
      <p>
        <a href="#"
           tal:attributes="
             href context/absolute_url;
           "
           i18n:translate=""
        >Go back</a>
      </p>
    </metal:main>
  </body>
</html>

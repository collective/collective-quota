msgstr "Acciones"

#: collective/quota/vocabularies/policies.py:18
msgid "Allow everything, only show warnings"
msgstr "Permitir todo, solo mostrar avisos"

#: collective/quota/vocabularies/policies.py:16
msgid "Allow new items, block uploads that add bytes"
msgstr "Permitir elementos nuevos, bloquear las subidas que añaden bytes"

#: collective/quota/vocabularies/policies.py:17
msgid "Allow uploads up to a maximum file size"
msgstr "Permitir subidas hasta un tamaño máximo de archivo"

#: collective/quota/vocabularies/policies.py:15
msgid "Block new items and any upload that adds bytes"
msgstr "Bloquear elementos nuevos y cualquier subida que añada bytes"


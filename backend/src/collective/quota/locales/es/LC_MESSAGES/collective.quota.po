msgstr "Actualmente: ${value} (de la variable de entorno ${variable}, bloqueado)."

#: collective/quota/controlpanels/quota.py:68
msgid "Currently: ${value} (from environment variable ${variable}; a value saved here takes precedence)."
msgstr "Actualmente: ${value} (de la variable de entorno ${variable}; un valor guardado aquí tiene prioridad)."

#: collective/quota/controlpanels/quota.py:74
msgid "Currently: ${value} (set in this control panel)."
msgstr "Actualmente: ${value} (definido en este panel de control)."

#: collective/quota/controlpanels/quota.py:41
msgid "Default"
msgstr "Predeterminado"

#: collective/quota/browser/templates/delete_confirmation.pt:111
#: collective/quota/browser/templates/usage.pt:238
msgid "Delete"
msgstr "Eliminar"

#: collective/quota/browser/templates/usage.pt:250
msgid "Delete selected"
msgstr "Eliminar seleccionados"

#: collective/quota/browser/templates/delete_confirmation.pt:19
msgid "Delete selected items"
msgstr "Eliminar los elementos seleccionados"

#: collective/quota/browser/delete.py:114
msgid "Deleted ${count} items, freeing ${size}."
msgstr "Se eliminaron ${count} elementos y se liberaron ${size}."

#: collective/quota/browser/templates/quota_error.pt:12
msgid "Disk quota exceeded"
msgstr "Cuota de disco superada"

#: collective/quota/browser/summary.py:49
msgid "Disk quota exceeded: this site uses ${used} of ${limit}. ${policy_hint}"
msgstr "Cuota de disco superada: este sitio usa ${used} de ${limit}. ${policy_hint}"

#: collective/quota/profiles.zcml:14
msgid "Disk quota for Plone sites: measures the space used by uploaded files and images, warns editors near the limit, enforces a hard limit, and helps find and delete the biggest items."
msgstr "Cuota de disco para sitios Plone: mide el espacio que ocupan los archivos e imágenes subidos, avisa a los editores cerca del límite, aplica un límite estricto y ayuda a encontrar y eliminar los elementos más grandes."

#: collective/quota/browser/templates/usage.pt:14
#: collective/quota/profiles/default/actions.xml
msgid "Disk usage"
msgstr "Uso del disco"

#: collective/quota/browser/summary.py:60
msgid "Disk usage warning: this site uses ${used} of ${limit} (${percent}%). Please review large files before the limit is reached."
msgstr "Aviso de uso del disco: este sitio usa ${used} de ${limit} (${percent}%). Revise los archivos grandes antes de alcanzar el límite."

#: collective/quota/browser/templates/delete_confirmation.pt:30
msgid "Do you really want to delete the following ${count} items (${size} in total)?"
msgstr "¿Seguro que desea eliminar los siguientes ${count} elementos (${size} en total)?"

#: collective/quota/browser/templates/usage.pt:229
msgid "Edit"
msgstr "Editar"

#: collective/quota/controlpanels/quota.py:39
msgid "Environment"
msgstr "Entorno"

#: collective/quota/controlpanels/quota.py:40
msgid "Environment (locked)"
msgstr "Entorno (bloqueado)"

#: collective/quota/browser/templates/controlpanel.pt:128
msgid "Environment variable"
msgstr "Variable de entorno"

#: collective/quota/browser/templates/quota_error.pt:25
msgid "Go back"
msgstr "Volver"

#: collective/quota/interfaces.py:40
msgid "Hard limit (MB)"
msgstr "Límite estricto (MB)"

#: collective/quota/browser/templates/controlpanel.pt:76
#: collective/quota/browser/templates/usage.pt:65
msgid "Hard limit:"
msgstr "Límite estricto:"

#: collective/quota/interfaces.py:52
msgid "Leave empty to use the environment variable or the default."
msgstr "Déjelo vacío para usar la variable de entorno o el valor predeterminado."

#: collective/quota/controlpanels/quota.py:82
msgid "Limits apply to the bytes stored in file and image fields across the whole site."
msgstr "Los límites se aplican a los bytes guardados en campos de archivo e imagen de todo el sitio."

#: collective/quota/browser/templates/usage.pt:175
msgid "Location"
msgstr "Ubicación"

#: collective/quota/interfaces.py:58
msgid "Maximum file size over the limit (MB)"
msgstr "Tamaño máximo de archivo por encima del límite (MB)"

#: collective/quota/browser/templates/usage.pt:179
msgid "Modified"
msgstr "Modificado"

#: collective/quota/browser/summary.py:30
msgid "New content and uploads are blocked until files are removed."
msgstr "El contenido nuevo y las subidas están bloqueados hasta que se eliminen archivos."

#: collective/quota/policy.py:33
msgid "New content cannot be added: the site has reached its disk quota (${used} of ${limit}). Delete or shrink existing files first."
msgstr "No se puede añadir contenido nuevo: el sitio alcanzó su cuota de disco (${used} de ${limit}). Primero elimine o reduzca archivos existentes."

#: collective/quota/browser/delete.py:41
msgid "No items selected."
msgstr "No se seleccionó ningún elemento."

#: collective/quota/browser/templates/usage.pt:156
msgid "No uploaded files or images found."
msgstr "No se encontraron archivos ni imágenes subidos."

#: collective/quota/browser/templates/delete_confirmation.pt:94
msgid "None of the selected items exist any more."
msgstr "Ninguno de los elementos seleccionados existe ya."

#: collective/quota/browser/templates/quota_error.pt:20
msgid "Nothing was saved. Delete or shrink existing files, or ask a site administrator to raise the quota."
msgstr "No se guardó nada. Elimine o reduzca archivos existentes, o pida a un administrador del sitio que aumente la cuota."

#: collective/quota/browser/templates/usage.pt:124
msgid "Number of items"
msgstr "Número de elementos"

#: collective/quota/browser/summary.py:38
msgid "Only files up to ${max_size} can be uploaded until files are removed."
msgstr "Solo se pueden subir archivos de hasta ${max_size} hasta que se eliminen archivos."

#: collective/quota/interfaces.py:59
msgid "Only used by the policy \"Allow uploads up to a maximum file size\". Leave empty to use the environment variable or the default."
msgstr "Solo se usa con la política «Permitir subidas hasta un tamaño máximo de archivo». Déjelo vacío para usar la variable de entorno o el valor predeterminado."

#: collective/quota/interfaces.py:51
msgid "Policy when the hard limit is reached"
msgstr "Política al alcanzar el límite estricto"

#: collective/quota/browser/templates/controlpanel.pt:83
#: collective/quota/browser/templates/usage.pt:71
msgid "Policy:"
msgstr "Política:"

#: collective/quota/controlpanels/restapi.py:49
#: collective/quota/profiles/default/controlpanel.xml
msgid "Quota"
msgstr "Cuota"

#: collective/quota/browser/templates/usage.pt:80
#: collective/quota/controlpanels/quota.py:81
msgid "Quota settings"
msgstr "Configuración de la cuota"

#: collective/quota/browser/templates/controlpanel.pt:163
#: collective/quota/browser/templates/usage.pt:94
msgid "Rebuild usage data"
msgstr "Recalcular los datos de uso"

#: collective/quota/browser/templates/controlpanel.pt:166
msgid "Recomputes the size of every item and the site total. It walks the whole catalog, so it can take a while on big sites. Use it if the total looks wrong."
msgstr "Vuelve a calcular el tamaño de cada elemento y el total del sitio. Recorre todo el catálogo, así que puede tardar en sitios grandes. Úselo si el total parece incorrecto."

#: collective/quota/controlpanels/quota.py:142
msgid "Reset to defaults"
msgstr "Restablecer valores predeterminados"

#: collective/quota/browser/templates/controlpanel.pt:95
msgid "Review biggest items"
msgstr "Revisar los elementos más grandes"

#: collective/quota/browser/templates/warning_viewlet.pt:11
msgid "Review disk usage"
msgstr "Revisar el uso del disco"

#: collective/quota/browser/templates/usage.pt:166
msgid "Select all"
msgstr "Seleccionar todo"

#: collective/quota/settings.py:53
msgid "Set a maximum file size greater than 0 for this policy."
msgstr "Defina un tamaño máximo de archivo mayor que 0 para esta política."

#: collective/quota/browser/templates/controlpanel.pt:125
msgid "Setting"
msgstr "Opción"

#: collective/quota/controlpanels/restapi.py:94
msgid "Setting ${name} is locked by environment variable ${variable}"
msgstr "La opción ${name} está bloqueada por la variable de entorno ${variable}"

#: collective/quota/browser/templates/controlpanel.pt:112
msgid "Settings defined by environment variables are locked (COLLECTIVE_QUOTA_LOCK_SETTINGS is on). Only the server operator can change them."
msgstr "Las opciones definidas por variables de entorno están bloqueadas (COLLECTIVE_QUOTA_LOCK_SETTINGS está activo). Solo el operador del servidor puede cambiarlas."

#: collective/quota/controlpanels/quota.py:149
msgid "Settings reset. Environment variables or built-in defaults apply now."
msgstr "Opciones restablecidas. Ahora se aplican las variables de entorno o los valores predeterminados."

#: collective/quota/browser/templates/usage.pt:140
msgid "Show"
msgstr "Mostrar"

#: collective/quota/browser/templates/delete_confirmation.pt:42
#: collective/quota/browser/templates/usage.pt:176
msgid "Size"
msgstr "Tamaño"

#: collective/quota/browser/templates/usage.pt:261
msgid "Sizes include only uploaded files and images. Showing the ${limit} largest items you can see."
msgstr "Los tamaños solo incluyen archivos e imágenes subidos. Se muestran los ${limit} elementos más grandes que puede ver."

#: collective/quota/browser/delete.py:125
msgid "Skipped ${title}: ${reason}."
msgstr "Se omitió ${title}: ${reason}."

#: collective/quota/interfaces.py:29
msgid "Soft limit (MB)"
msgstr "Límite de aviso (MB)"

#: collective/quota/browser/templates/controlpanel.pt:69
#: collective/quota/browser/templates/usage.pt:59
msgid "Soft limit:"
msgstr "Límite de aviso:"

#: collective/quota/browser/templates/controlpanel.pt:127
msgid "Source"
msgstr "Origen"

#: collective/quota/guard.py:36
msgid "The change was cancelled: it would add ${delta} to the site and exceed the disk quota (${used} of ${limit})."
msgstr "Se canceló el cambio: añadiría ${delta} al sitio y superaría la cuota de disco (${used} de ${limit})."

#: collective/quota/guard.py:40
msgid "The change was cancelled: new content cannot be added while the site exceeds its disk quota (${used} of ${limit})."
msgstr "Se canceló el cambio: no se puede añadir contenido nuevo mientras el sitio supera su cuota de disco (${used} de ${limit})."

#: collective/quota/browser/templates/delete_confirmation.pt:80
msgid "The following items will not be deleted:"
msgstr "Los siguientes elementos no se eliminarán:"

#: collective/quota/policy.py:29
msgid "The site has reached its disk quota (${used} of ${limit}); only files up to ${max_size} can be added now. This file is ${size}."
msgstr "El sitio alcanzó su cuota de disco (${used} de ${limit}); ahora solo se pueden añadir archivos de hasta ${max_size}. Este archivo ocupa ${size}."

#: collective/quota/settings.py:52
msgid "The soft limit cannot be higher than the hard limit."
msgstr "El límite de aviso no puede ser mayor que el límite estricto."

#: collective/quota/policy.py:25
msgid "This file cannot be saved: the site has reached its disk quota (${used} of ${limit}). Delete or shrink existing files first."
msgstr "No se puede guardar este archivo: el sitio alcanzó su cuota de disco (${used} de ${limit}). Primero elimine o reduzca archivos existentes."

#: collective/quota/browser/templates/delete_confirmation.pt:40
#: collective/quota/browser/templates/usage.pt:173
msgid "Title"
msgstr "Título"

#: collective/quota/browser/templates/controlpanel.pt:37
#: collective/quota/browser/templates/usage.pt:26
msgid "Total:"
msgstr "Total:"

#: collective/quota/browser/templates/delete_confirmation.pt:41
#: collective/quota/browser/templates/usage.pt:174
msgid "Type"
msgstr "Tipo"

#: collective/quota/profiles.zcml:31
msgid "Uninstall Collective Quota setup."
msgstr "Desinstala la configuración de Collective Quota."

#: collective/quota/browser/summary.py:31
msgid "Uploads are blocked until files are removed."
msgstr "Las subidas están bloqueadas hasta que se eliminen archivos."

#: collective/quota/browser/summary.py:32
msgid "Uploads are still allowed."
msgstr "Las subidas siguen permitidas."

#: collective/quota/browser/rebuild.py:24
msgid "Usage data rebuilt: ${count} items, ${total} in total."
msgstr "Datos de uso recalculados: ${count} elementos, ${total} en total."

#: collective/quota/browser/templates/controlpanel.pt:126
msgid "Value"
msgstr "Valor"

#: collective/quota/interfaces.py:41
msgid "When a save would push total usage above this value, the policy below applies. 0 disables enforcement. Leave empty to use the environment variable or the default."
msgstr "Cuando un guardado haría que el uso total supere este valor, se aplica la política de abajo. 0 desactiva el control. Déjelo vacío para usar la variable de entorno o el valor predeterminado."

#: collective/quota/interfaces.py:30
msgid "When total usage reaches this value, editors see a warning. 0 disables the warning. Leave empty to use the environment variable or the default."
msgstr "Cuando el uso total alcanza este valor, los editores ven un aviso. 0 desactiva el aviso. Déjelo vacío para usar la variable de entorno o el valor predeterminado."

#: collective/quota/browser/templates/controlpanel.pt:109
msgid "Where the values come from"
msgstr "De dónde vienen los valores"

#: collective/quota/browser/templates/usage.pt:198
msgid "You cannot delete this item"
msgstr "No puede eliminar este elemento"

#: collective/quota/browser/templates/controlpanel.pt:71
#: collective/quota/browser/templates/usage.pt:61
msgid "disabled"
msgstr "desactivado"

#: collective/quota/browser/delete.py:27
msgid "it is locked by another user"
msgstr "está bloqueado por otro usuario"

#: collective/quota/browser/templates/controlpanel.pt:42
#: collective/quota/browser/templates/usage.pt:31
msgid "of"
msgstr "de"

#: collective/quota/browser/delete.py:26

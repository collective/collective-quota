# syntax=docker/dockerfile:1
ARG PLONE_VERSION=6.2.2
FROM plone/server-builder:${PLONE_VERSION} AS builder

WORKDIR /app


# Add local code
COPY scripts/ scripts/
COPY . src

# Install local requirements and pre-compile mo files
RUN <<EOT
    set -e
    bin/pip install mxdev uv
    sed -i 's/-e .\[test,acceptance\]/.[acceptance]/g' src/mx.ini
    cd /app/src
    # remove potentially existing virtualenv from local build
    rm -rf .venv
    ../bin/mxdev -c mx.ini
    ../bin/uv pip install -r requirements-mxdev.txt
    ../bin/python /compile_mo.py
EOT

FROM plone/server-acceptance:${PLONE_VERSION}

LABEL maintainer="Enfold Systems, Inc. <info@enfoldsystems.com>" \
      org.label-schema.name="collective-quota-acceptance" \
      org.label-schema.description="Collective Quota backend acceptance image." \
      org.label-schema.vendor="Enfold Systems, Inc."

ENV CONFIGURE_PACKAGES="plone.restapi,plone.volto,plone.volto.cors,collective.quota"
ENV APPLY_PROFILES="plone.volto:default,collective.quota:default"
ENV INSTALL_PRODUCTS="collective.quota"

# Copy /app from builder
COPY --from=builder /app /app

RUN <<EOT
    ln -s /data /app/var
EOT
